<mujoco model="ROB 345/549 Lab 2 example pipe course">
  <!--
    Example PVC-pipe obstacle course for testing Lab 2 in the CrazySim/MuJoCo
    backend. Geometry here MUST stay in sync with worlds/mujoco/lab_course.py
    (see that file for the matching Part III numbers).

    Frame: the drone spawns at world (x, y) = (0, 0) facing +X, and its onboard
    estimator is zeroed at the start, so the lab's arena frame (origin at the
    start, +x forward, +y left) is identical to this MuJoCo world frame.
      * cage  : the rectangle [0, 3] x [0, 3]  (orange tape, visual only)
      * pipes : true radius 0.05 m  (the planner inflates these by 0.15 m)
      * start : (0, 0)      [X inside a square]
      * goal  : (2.55, 2.55) [square]
  -->
  <option integrator="RK4" density="1.225" viscosity="1.8e-5" timestep="0.001"/>
  <compiler inertiafromgeom="false" autolimits="true"/>
  <statistic center="1.5 1.5 1" extent="3.2"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.5 0.5 0.5" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 0" fog="1 1 1 0"/>
    <map fogstart="0" fogend="0"/>
    <global azimuth="0" elevation="-20" ellipsoidinertia="true"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
             markrgb="0.8 0.8 0.8" width="512" height="512"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="3 3" reflectance="0.2"/>
    <material name="pipe" rgba="0.92 0.92 0.95 1"/>
    <material name="tape" rgba="1.0 0.55 0.0 1"/>
    <material name="startmark" rgba="0.05 0.05 0.05 1"/>
    <material name="goalmark" rgba="0.004 0.596 0.105 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Orange tape: rectangular cage boundary [0,3] x [0,3] (visual only) -->
    <geom name="tape_y0" type="box" size="1.5 0.008 0.006" pos="1.5 0.0 0.006"
          material="tape" contype="0" conaffinity="0"/>
    <geom name="tape_y3" type="box" size="1.5 0.008 0.006" pos="1.5 3.0 0.006"
          material="tape" contype="0" conaffinity="0"/>
    <geom name="tape_x0" type="box" size="0.008 1.5 0.006" pos="0.0 1.5 0.006"
          material="tape" contype="0" conaffinity="0"/>
    <geom name="tape_x3" type="box" size="0.008 1.5 0.006" pos="3.0 1.5 0.006"
          material="tape" contype="0" conaffinity="0"/>

    <!-- PVC pipe obstacles: radius 0.05 m, floor to 1.5 m -->
    <geom name="pipe1" type="cylinder" size="0.05 0.75" pos="0.9 1.0 0.75"
          material="pipe" contype="1" conaffinity="1"/>
    <geom name="pipe2" type="cylinder" size="0.05 0.75" pos="1.5 0.5 0.75"
          material="pipe" contype="1" conaffinity="1"/>
    <geom name="pipe3" type="cylinder" size="0.05 0.75" pos="1.5 1.5 0.75"
          material="pipe" contype="1" conaffinity="1"/>
    <geom name="pipe4" type="cylinder" size="0.05 0.75" pos="2.1 1.0 0.75"
          material="pipe" contype="1" conaffinity="1"/>
    <geom name="pipe5" type="cylinder" size="0.05 0.75" pos="0.9 2.4 0.75"
          material="pipe" contype="1" conaffinity="1"/>
    <geom name="pipe6" type="cylinder" size="0.05 0.75" pos="1.9 2.6 0.75"
          material="pipe" contype="1" conaffinity="1"/>
    <geom name="pipe7" type="cylinder" size="0.05 0.75" pos="2.6 1.8 0.75"
          material="pipe" contype="1" conaffinity="1"/>

    <!-- Start marker at (0,0): square outline + X (visual only) -->
    <geom name="start_b" type="box" size="0.15 0.008 0.006" pos="0.0 -0.15 0.006"
          material="startmark" contype="0" conaffinity="0"/>
    <geom name="start_t" type="box" size="0.15 0.008 0.006" pos="0.0 0.15 0.006"
          material="startmark" contype="0" conaffinity="0"/>
    <geom name="start_l" type="box" size="0.008 0.15 0.006" pos="-0.15 0.0 0.006"
          material="startmark" contype="0" conaffinity="0"/>
    <geom name="start_r" type="box" size="0.008 0.15 0.006" pos="0.15 0.0 0.006"
          material="startmark" contype="0" conaffinity="0"/>
    <geom name="start_x1" type="box" size="0.212 0.008 0.006" pos="0.0 0.0 0.006"
          quat="0.92388 0 0 0.38268" material="startmark" contype="0" conaffinity="0"/>
    <geom name="start_x2" type="box" size="0.212 0.008 0.006" pos="0.0 0.0 0.006"
          quat="0.92388 0 0 -0.38268" material="startmark" contype="0" conaffinity="0"/>

    <!-- Goal marker at (2.55,2.55): square outline (visual only) -->
    <geom name="goal_b" type="box" size="0.15 0.008 0.006" pos="2.55 2.40 0.006"
          material="goalmark" contype="0" conaffinity="0"/>
    <geom name="goal_t" type="box" size="0.15 0.008 0.006" pos="2.55 2.70 0.006"
          material="goalmark" contype="0" conaffinity="0"/>
    <geom name="goal_l" type="box" size="0.008 0.15 0.006" pos="2.40 2.55 0.006"
          material="goalmark" contype="0" conaffinity="0"/>
    <geom name="goal_r" type="box" size="0.008 0.15 0.006" pos="2.70 2.55 0.006"
          material="goalmark" contype="0" conaffinity="0"/>
  </worldbody>
</mujoco>
